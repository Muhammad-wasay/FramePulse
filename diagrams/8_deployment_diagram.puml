@startuml
skinparam backgroundColor #FFFFFF
skinparam roundCorner 8
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam node {
    BackgroundColor #FAF7F3
    BorderColor #6F4E37
    FontColor #3B2A20
}
skinparam artifact {
    BackgroundColor #FFFFFF
    BorderColor #6F4E37
    FontColor #3B2A20
}
skinparam database {
    BackgroundColor #EFECE6
    BorderColor #6F4E37
    FontColor #3B2A20
}
skinparam arrow {
    Color #6F4E37
    FontColor #3B2A20
}

node "Client Device\n(Gamer / Admin PC / Browser)" as Client {
    artifact "React + Vite Web App\n(Vercel Production Edge)" as WebApp
    artifact "Java Swing Desktop Client\n(MainFrame.java / Java 17)" as DesktopGUI
}

node "Application Server /\nExecution Environment" as Server {
    artifact "Core Business Logic\n(Game, Review, PerformanceLog)" as Logic
    artifact "Analytics Engine\n(Singleton Pattern)" as Engine
    artifact "Embedded HTTP REST Server\n(ApiServer.java :8080)" as RestServer
}

node "Supabase Cloud Platform /\nDatabase Node" as DBNode {
    database "PostgreSQL Relational DB\n(games, reviews, sessions)" as DB
    artifact "Supabase PostgREST &\nAuth Service" as SupaAuth
}

Client -down-> Server : HTTP / REST API (:8080)\n(Local Zero-Dep Execution)
Client -down-> DBNode : HTTPS / PostgREST\n(Cloud Persistence & Auth)
Server -down-> DBNode : SQL Queries / REST Data Sync
@enduml
